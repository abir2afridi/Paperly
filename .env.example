# Supabase configuration (copy to .env and fill in your values)
# Get these from: Supabase Dashboard -> Project Settings -> API
# NOTE: The anon/public key is safe to embed in the client. RLS policies protect the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key (Supabase Dashboard -> Project Settings -> API -> service_role).
# Server-only secret. Required for §34 session/device management and §40 chat-retention
# sweep (GoTrue admin REST + admin.rpc('sweep_expired_chat')). NEVER expose in the
# browser bundle or the desktop build. Without it those routes return honest 501s.
SUPABASE_SERVICE_ROLE_KEY=

# Real-time collaboration (Yjs) WebSocket server URL.
# - Web (self-hosted node server): leave unset; the app derives ws(s)://same-host/collab
# - Desktop build: REQUIRED, point at a running collab server, e.g. ws://127.0.0.1:3000/collab
#   (or a remote wss:// URL for multi-machine collab; the path must be /collab)
VITE_COLLAB_URL=

# Transactional email delivery for notifications (plan §31) - optional; without it the app falls back to in-app only
RESEND_API_KEY=
EMAIL_FROM=Paperly <notifications@paperly.app>
