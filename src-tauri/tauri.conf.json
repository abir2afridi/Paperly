{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeXForge",
  "version": "0.0.0",
  "identifier": "com.texforge.app",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TeXForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "publisher": "TeXForge",
    "shortDescription": "Collaborative LaTeX editor with AI co-authoring",
    "longDescription": "TeXForge desktop edition — collaborative LaTeX editor with in-browser compilation, AI co-authoring, and version snapshots.",
    "category": "DeveloperTool",
    "copyright": "TeXForge",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
